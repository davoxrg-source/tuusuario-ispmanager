# Copia este archivo a .env y ajusta los valores antes de arrancar el backend.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://ispmanager:changeme@localhost:5432/ispmanager

# JWT
SECRET_KEY=changeme-genera-uno-con-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Clave Fernet para cifrar credenciales de Mikrotik/PPPoE en la base de datos.
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=changeme-clave-fernet-de-32-bytes-base64

# Polling de métricas de dispositivos Mikrotik (segundos)
DEVICE_POLL_INTERVAL_SECONDS=300

# Correo saliente para notificaciones al cliente (portal de autoservicio).
# Sin esto configurado, los envíos quedan registrados como fallidos pero no
# rompen nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Push del navegador (Web Push / VAPID) para el portal de cliente.
# Generar el par con: python -m app.cli.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com

# Pasarela de pago Wompi (Colombia). Sacar las claves de sandbox en
# https://comercios.wompi.co (gratis) antes de probar en serio -- sin
# esto, generar un link de pago falla con gracia (400).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

# Push nativo (FCM) para las apps móviles (mobile-client/mobile-staff).
# Sacar el JSON de la service account desde la consola de Firebase
# (Configuración del proyecto > Cuentas de servicio > Generar nueva clave
# privada), pegado acá como un único valor de una línea.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Entorno
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173
